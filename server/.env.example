PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai_interviewer?retryWrites=true&w=majority

# Primary LLM (Google AI Studio)
GEMINI_API_KEY=
# Comma-separated, tried in order before the fallback provider
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite

# Fallback LLM: any OpenAI-compatible API. Leave key empty to disable.
#   Groq: https://api.groq.com/openai/v1  model llama-3.3-70b-versatile
#   xAI:  https://api.x.ai/v1             model grok-3-mini
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_MODEL=llama-3.3-70b-versatile

LLM_TIMEOUT_MS=10000
LLM_REPORT_TIMEOUT_MS=30000
