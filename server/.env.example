PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai_interviewer?retryWrites=true&w=majority

# Which LLM is tried first: openai_compat (Groq, fast) or gemini. The other one is the backup.
LLM_PRIMARY=openai_compat

# OpenAI-compatible API. Set at least one of the two keys.
#   Groq: https://api.groq.com/openai/v1  models qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
#         (comma-separated, tried in order; Groq rate-limits each model separately)
#   xAI:  https://api.x.ai/v1             model grok-3-mini
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b

# Google AI Studio. Comma-separated models, tried in order.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

LLM_TIMEOUT_MS=20000
LLM_REPORT_TIMEOUT_MS=30000

# Reverse-proxy hops in front of the server: 0 locally, 1 on Render.
TRUST_PROXY=0
